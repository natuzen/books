---
---
<footer class="bg-epoca-marron text-epoca-crema mt-16">
  <div class="max-w-7xl mx-auto px-4 py-10">
    <div class="text-center mb-6">
      <span class="ornament text-epoca-rosa-claro text-2xl">❧ ✦ ❧</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div>
        <h3 class="font-playfair text-lg text-epoca-rosa-claro mb-3">Queridos Lectores</h3>
        <p class="text-sm text-epoca-verde-claro leading-relaxed">Tu guía de novelas románticas. Descubre libros que harán latir tu corazón.</p>
      </div>
      <div>
        <h3 class="font-playfair text-lg text-epoca-rosa-claro mb-3">Nuestras RRSS</h3>
        <div class="flex flex-col gap-3">
          <a href="https://www.instagram.com/queridoslectores.oficial" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-epoca-verde-claro hover:text-white transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-epoca-rosa-claro transition-colors">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <circle cx="17.5" cy="6.5" r="1.5"></circle>
            </svg>
            <span class="text-sm">Instagram</span>
          </a>
        </div>
      </div>
      <div>
        <h3 class="font-playfair text-lg text-epoca-rosa-claro mb-3">Explorar</h3>
        <ul class="space-y-1 text-sm">
          <li><a href="/buscar" class="text-epoca-verde-claro hover:text-white transition-colors">Buscar libros</a></li>
          <li><a href="/listas" class="text-epoca-verde-claro hover:text-white transition-colors">Listas temáticas</a></li>
          <li><a href="/quiz" class="text-epoca-verde-claro hover:text-white transition-colors">Quiz literario</a></li>
          <li><a href="/mapa" class="text-epoca-verde-claro hover:text-white transition-colors">Mapa literario</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-playfair text-lg text-epoca-rosa-claro mb-3">Legal</h3>
        <ul class="space-y-1 text-sm">
          <li><a href="/acerca-de" class="text-epoca-verde-claro hover:text-white transition-colors">Acerca de</a></li>
          <li><a href="/contacto" class="text-epoca-verde-claro hover:text-white transition-colors">Contacto</a></li>
          <li><a href="/privacidad" class="text-epoca-verde-claro hover:text-white transition-colors">Privacidad</a></li>
          <li><a href="/aviso-legal" class="text-epoca-verde-claro hover:text-white transition-colors">Aviso Legal</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-epoca-marron-medio pt-4 text-center text-sm text-epoca-marron-medio">
      <p>&copy; {new Date().getFullYear()} Queridos Lectores. Hecho con amor por lectoras romanticistas.</p>
    </div>
  </div>
</footer>
